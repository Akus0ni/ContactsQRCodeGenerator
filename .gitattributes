# Normalise line endings: LF in the repository, native in the working tree.
* text=auto

# Source
*.cs        text diff=csharp
*.csx       text diff=csharp
*.xaml      text
*.axaml     text
*.razor     text diff=html

# Project and build
*.csproj    text
*.props     text
*.targets   text
*.ruleset   text
*.config    text
*.editorconfig text
*.sln       text eol=crlf

# Data and docs
*.md        text
*.json      text
*.yml       text
*.yaml      text
*.xml       text
*.resx      text
*.vcf       text eol=crlf

# Scripts
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.sh        text eol=lf

# Binary — never diffed, never line-ending-converted
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.bmp       binary
*.pdf       binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.dll       binary
*.exe       binary
*.pdb       binary
*.snk       binary
*.pfx       binary
*.zip       binary
*.db        binary
