root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,csproj,props,targets,slnx,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Namespaces
csharp_style_namespace_declarations = file_scoped:error

# var usage — explicit types where the type is not obvious from the right-hand side.
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Modern C# that improves readability rather than merely shortening.
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_prefer_braces = true:error

# Ordering
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

[tests/**/*.cs]
# CA1707 forbids underscores in member names. Test methods deliberately use
# Method_Scenario_ExpectedBehaviour, which is the convention this repository's tests are
# written to and which carries real information in a failure report. The rule is correct for
# production code and stays enabled there; it is switched off only under tests/.
dotnet_diagnostic.CA1707.severity = none

# Test classes are instantiated by xUnit, and fixtures legitimately hold state.
dotnet_diagnostic.CA1515.severity = none
